# ==========================================================
# RecruitOS Mini Provider Configuration
# ==========================================================

# Primary / Alternative Free-Tier Provider: Groq (Ultra-Fast & High Rate Limits)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: llama-3.3-70b-versatile, or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Free-Tier Provider: Google AI Studio (Gemini Flash)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# Optional Gemini model override (default: gemini-3.6-flash or gemini-1.5-flash)
# GEMINI_MODEL=gemini-3.6-flash
